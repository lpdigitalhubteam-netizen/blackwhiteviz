# Option A — Hostinger PHP relay (recommended on Vercel)
# Upload hostinger/enquiry.php to Hostinger public_html, then:
ENQUIRY_MAIL_URL=https://blackwhiteviz.com/mail/enquiry.php
ENQUIRY_MAIL_SECRET=your-long-random-secret

# Option B — Direct SMTP (works locally; often fails on Vercel)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=office@blackwhiteviz.com
SMTP_PASS=your-mailbox-password

ENQUIRY_FROM_EMAIL=Blackwhite Viz <office@blackwhiteviz.com>
ENQUIRY_TO_EMAIL=hello@blackwhiteviz.com
