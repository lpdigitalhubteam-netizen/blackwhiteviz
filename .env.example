# Option A — Hostinger PHP relay (recommended on Vercel if SMTP fails)
# Upload hostinger/enquiry.php to Hostinger public_html, then:
ENQUIRY_MAIL_URL=https://blackwhiteviz.com/mail/enquiry.php
ENQUIRY_MAIL_SECRET=your-long-random-secret

# Option B — Hostinger mailbox SMTP
# Check hPanel → Emails → office@ → Connect apps & devices for the exact host.
#
# Hostinger Email:
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
#
# Titan Email (webmail at hostinger.titan.email) — use this instead:
# SMTP_HOST=smtp.titan.email
# SMTP_PORT=587
#
SMTP_USER=office@blackwhiteviz.com
SMTP_PASS=your-mailbox-password

ENQUIRY_FROM_EMAIL=Blackwhite Viz <office@blackwhiteviz.com>
ENQUIRY_TO_EMAIL=office@blackwhiteviz.com
